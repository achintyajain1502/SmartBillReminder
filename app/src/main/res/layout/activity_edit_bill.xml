<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Bill"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1F2937" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Update your bill or subscription"
                android:textSize="14sp"
                android:textColor="#6B7280" />

            <EditText
                android:id="@+id/etEditBillName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Bill / Subscription Name"
                android:inputType="textCapSentences"
                android:padding="14dp" />

            <EditText
                android:id="@+id/etEditAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Amount (₹)"
                android:inputType="numberDecimal"
                android:padding="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Category"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#374151" />

            <Spinner
                android:id="@+id/spinnerEditCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Due / Renewal Date"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#374151" />

            <Button
                android:id="@+id/btnEditDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Select Date" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Recurrence"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#374151" />

            <Spinner
                android:id="@+id/spinnerEditRecurrence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <EditText
                android:id="@+id/etEditNotes"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="20dp"
                android:hint="Notes (Optional)"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btnUpdateBill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:text="UPDATE BILL"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>